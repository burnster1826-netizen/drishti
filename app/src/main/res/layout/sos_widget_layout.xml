<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/img_drishti_logo"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DRISHTI SOS"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/widget_sos_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_button_bg"
        android:text="🚨 TRIGGER SOS"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1-Tap Instant Emergency Alert"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
